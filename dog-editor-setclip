#!/usr/bin/env python3
import sys
import os

if len(sys.argv) < 2:
    sys.exit(0)

target = os.path.abspath(sys.argv[1])
uri_str = f"file://{target}"

try:
    from PyQt5 import QtWidgets, QtCore
    app = QtWidgets.QApplication(sys.argv[:1])
    cb = app.clipboard()
    md = QtCore.QMimeData()
    qurl = QtCore.QUrl.fromLocalFile(target)
    md.setUrls([qurl])
    md.setText(uri_str)
    gnome_data = f"copy\n{uri_str}\n".encode('utf-8')
    md.setData('x-special/gnome-copied-files', gnome_data)
    cb.setMimeData(md)
    cb.dataChanged.connect(app.quit)
    app.exec_()
except Exception:
    import subprocess
    try:
        subprocess.run(
            ["xclip", "-selection", "clipboard", "-t", "text/uri-list"],
            input=f"{uri_str}\r\n".encode('utf-8'),
            check=False
        )
    except Exception:
        pass
